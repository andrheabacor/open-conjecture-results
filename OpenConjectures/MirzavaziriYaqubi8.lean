import Mathlib.Combinatorics.Enumerative.IncidenceAlgebra
import Mathlib.Data.Nat.Factors
import Mathlib.Tactic

/-!
# The refinement order for factorizations

The endpoints use sorted lists of ordinary natural factors. An elementary step
chooses two positions, replaces their factors with their product and puts the
remaining factors back into sorted order. The order is the reflexive, transitive
closure of these steps. Only the interval between a number's prime list and its
one-factor list enters its Möbius value.
-/

namespace MirzavaziriYaqubi.Factorizations

/-- Choose one occurrence, returning the chosen item and the remaining list. -/
def picks {α : Type} : List α → List (α × List α)
  | [] => []
  | a :: as => (a, as) :: (picks as).map (fun p => (p.1, a :: p.2))

theorem picks_length {α : Type} {xs : List α} {p : α × List α}
    (h : p ∈ picks xs) : p.2.length + 1 = xs.length := by
  induction xs generalizing p with
  | nil => simp [picks] at h
  | cons a as ih =>
    simp only [picks, List.mem_cons, List.mem_map] at h
    rcases h with rfl | ⟨z, hz, rfl⟩
    · simp
    · simpa using congrArg Nat.succ (ih hz)

/-- Insert a factor into the canonical nondecreasing list. -/
def insertFactor (v : ℕ) : List ℕ → List ℕ
  | [] => [v]
  | w :: ws => if v ≤ w then v :: w :: ws else w :: insertFactor v ws

@[simp] theorem length_insertFactor (v : ℕ) (xs : List ℕ) :
    (insertFactor v xs).length = xs.length + 1 := by
  induction xs with
  | nil => rfl
  | cons w ws ih => simp [insertFactor, ih, apply_ite List.length]

/-- Enumerate the two choices independently. Duplicated edges have no effect on reachability. -/
def merges (xs : List ℕ) : List (List ℕ) :=
  (picks xs).flatMap fun a =>
    (picks a.2).map fun b => insertFactor (a.1 * b.1) b.2

theorem merges_length {xs ys : List ℕ} (h : ys ∈ merges xs) : ys.length < xs.length := by
  obtain ⟨a, ha, h⟩ := List.mem_flatMap.mp h
  obtain ⟨b, hb, rfl⟩ := List.mem_map.mp h
  have h₁ := picks_length ha
  have h₂ := picks_length hb
  simp only [length_insertFactor]
  omega

/-- Using a new type keeps refinement separate from the lexicographic order on lists. -/
@[ext] structure Node where
  factors : List ℕ
  deriving DecidableEq, Inhabited

def Step (x y : Node) : Prop := y.factors ∈ merges x.factors

theorem step_shorter {x y : Node} (h : Step x y) : y.factors.length < x.factors.length :=
  merges_length h

abbrev Reach := Relation.ReflTransGen Step

theorem reach_length {x y : Node} (h : Reach x y) : y.factors.length ≤ x.factors.length := by
  induction h with
  | refl => rfl
  | tail _ hs ih => exact (step_shorter hs).le.trans ih

instance : PartialOrder Node where
  le := Reach
  le_refl _ := .refl
  le_trans _ _ _ := Relation.ReflTransGen.trans
  le_antisymm x y hxy hyx := by
    rcases Relation.ReflTransGen.cases_head hxy with he | ⟨z, hxz, hzy⟩
    · exact he
    · have h₁ := step_shorter hxz
      have h₂ := reach_length hzy
      have h₃ := reach_length hyx
      omega

/-- Every reachable endpoint lies in this finite set once the depth is large enough. -/
def reachableWithin : ℕ → Node → Finset Node
  | 0, x => {x}
  | k+1, x => insert x ((merges x.factors).toFinset.biUnion fun f => reachableWithin k ⟨f⟩)

theorem mem_reachableWithin {k : ℕ} {x y : Node} (hx : x.factors.length ≤ k)
    (h : x ≤ y) : y ∈ reachableWithin k x := by
  induction k generalizing x y with
  | zero =>
    rcases Relation.ReflTransGen.cases_head h with rfl | ⟨z, hxz, _⟩
    · simp [reachableWithin]
    · have hz := step_shorter hxz
      omega
  | succ k ih =>
    rcases Relation.ReflTransGen.cases_head h with rfl | ⟨z, hxz, hzy⟩
    · simp [reachableWithin]
    · apply Finset.mem_insert_of_mem
      apply Finset.mem_biUnion.mpr
      refine ⟨z.factors, List.mem_toFinset.mpr hxz, ih ?_ hzy⟩
      change z.factors.length ≤ k
      have hz := step_shorter hxz
      omega

noncomputable instance : LocallyFiniteOrder Node :=
  LocallyFiniteOrder.ofFiniteIcc fun x _ =>
    (reachableWithin x.factors.length x).finite_toSet.subset fun _ hy =>
      mem_reachableWithin le_rfl hy.1

/-- The one-factor endpoint, with the conventional empty factorization of one. -/
def topNode (n : ℕ) : Node := ⟨if n = 1 then [] else [n]⟩

def bottomNode (n : ℕ) : Node := ⟨n.primeFactorsList⟩

noncomputable def factorMu (n : ℕ) : ℤ :=
  IncidenceAlgebra.mu ℤ (bottomNode n) (topNode n)

/-- Both assertions of Mirzavaziri and Yaqubi's Conjecture 8. -/
def Conjecture8 : Prop :=
  ∀ n : ℕ, 0 < n →
    (factorMu n = 0 ∨ Int.sign (factorMu n) = (-1 : ℤ) ^ (n.primeFactorsList.length + 1)) ∧
    (∀ p k : ℕ, p.Prime → 3 ≤ k → n = p ^ k → factorMu n = 0)

end MirzavaziriYaqubi.Factorizations


namespace MirzavaziriYaqubi.Factorizations

/-! The certificate contains labels, the indices of all pair mergers, and the claimed
upper-set bit masks and Möbius values. The theorem below checks their meaning without
trusting the program that produced the table. -/

structure Row where
  node : Node
  children : List ℕ
  mask : ℕ
  value : ℤ
  count : ℕ
  packedIndices : ℕ
  deriving Inhabited

def bit (i : ℕ) : ℕ := 1 <<< i

theorem bit_eq (i : ℕ) : bit i = 2 ^ i := Nat.one_shiftLeft i

def maskOf (xs : List ℕ) := xs.foldr (fun i m => bit i ||| m) 0

def fromChildren (r : ℕ → Row) (i : ℕ) :=
  (r i).children.foldr (fun j m => (r j).mask ||| m) (bit i)

/-- Read 11-bit row indices. Rebuilding the bit mask and checking their order
independently verifies every supplied list. -/
def unpack : ℕ → ℕ → List ℕ
  | 0, _ => []
  | k + 1, m => (m % 2048) :: unpack k (m / 2048)

def members (r : ℕ → Row) (i : ℕ) := unpack (r i).count (r i).packedIndices

def score (x : Node) := x.factors.foldl (fun a b => a * 100000 + b) 0

/-- A row-local checklist. All computations are on finite lists and integers. -/
def LocalFacts (r : ℕ → Row) (i : ℕ) : Prop :=
  ((r i).children.map (fun j => (r j).node.factors) = merges (r i).node.factors) ∧
  ((r i).children.all (fun j => decide (j < i)) = true) ∧
  (r i).mask = fromChildren r i ∧
  maskOf (members r i) = (r i).mask ∧
  (members r i).IsChain (· > ·) ∧
  ((members r i).all (fun j => decide (j ≤ i)) = true) ∧
  (0 ∈ members r i) ∧
  ((members r i).map fun j => (r j).value).sum = (if i = 0 then 1 else 0) ∧
  (i = 0 ∨ score (r (i-1)).node < score (r i).node)

instance (r : ℕ → Row) (i : ℕ) : Decidable (LocalFacts r i) := by
  unfold LocalFacts
  infer_instance

private theorem mem_maskOf (j : ℕ) (xs : List ℕ) :
    (maskOf xs).testBit j = true ↔ j ∈ xs := by
  induction xs with
  | nil => simp [maskOf]
  | cons a xs ih =>
    change (bit a ||| maskOf xs).testBit j = true ↔ j ∈ a :: xs
    rw [Nat.testBit_or, Bool.or_eq_true, bit_eq, Nat.testBit_two_pow, decide_eq_true_eq, ih, List.mem_cons]
    exact or_congr eq_comm Iff.rfl

private theorem child_testBit (r : ℕ → Row) (i j : ℕ) :
    (fromChildren r i).testBit j = true ↔ j = i ∨
      ∃ k ∈ (r i).children, (r k).mask.testBit j = true := by
  unfold fromChildren
  induction (r i).children with
  | nil => simpa only [List.foldr, bit_eq, Nat.testBit_two_pow, decide_eq_true_eq, List.not_mem_nil,
      false_and, exists_false, or_false] using (eq_comm (a := i) (b := j))
  | cons a xs ih =>
    simp only [List.foldr, Nat.testBit_or, Bool.or_eq_true, ih, List.mem_cons]
    aesop

private theorem local_members (r : ℕ → Row) (h : ∀ i < n, LocalFacts r i)
    {i : ℕ} (hi : i < n) (j : ℕ) :
    j ∈ members r i ↔ j = i ∨ ∃ k ∈ (r i).children, j ∈ members r k := by
  obtain ⟨_, hc, hm, he, _⟩ := h i hi
  rw [← mem_maskOf, he, hm, child_testBit]
  constructor
  · rintro (heq | ⟨k, hk, hb⟩)
    · exact Or.inl heq
    · have hki : k < i := of_decide_eq_true (List.all_eq_true.mp hc k hk)
      exact Or.inr ⟨k, hk, (mem_maskOf j _).mp (by rwa [(h k (hki.trans hi)).2.2.2.1])⟩
  · rintro (heq | ⟨k, hk, hb⟩)
    · exact Or.inl heq
    · have hki : k < i := of_decide_eq_true (List.all_eq_true.mp hc k hk)
      exact Or.inr ⟨k, hk, by rw [← (h k (hki.trans hi)).2.2.2.1]; exact (mem_maskOf j _).mpr hb⟩

private theorem reach_iff_members (r : ℕ → Row) (h : ∀ i < n, LocalFacts r i)
    {i : ℕ} (hi : i < n) (y : Node) :
    (r i).node ≤ y ↔ ∃ j ∈ members r i, (r j).node = y := by
  induction i using Nat.strong_induction_on generalizing y with
  | ind i ih =>
    obtain ⟨he, hc, _⟩ := h i hi
    have smaller {k} (hk : k ∈ (r i).children) : k < i :=
      of_decide_eq_true (List.all_eq_true.mp hc k hk)
    have hs {z : Node} : Step (r i).node z ↔ ∃ k ∈ (r i).children, (r k).node = z := by
      unfold Step
      rw [← he, List.mem_map]
      exact exists_congr fun k => and_congr_right fun _ => Node.ext_iff.symm
    constructor
    · intro hle
      rcases Relation.ReflTransGen.cases_head hle with rfl | ⟨z, hz, hzy⟩
      · exact ⟨i, (local_members r h hi i).mpr (Or.inl rfl), rfl⟩
      · obtain ⟨k, hk, rfl⟩ := hs.mp hz
        obtain ⟨j, hj, rfl⟩ := (ih k (smaller hk) ((smaller hk).trans hi) _).mp hzy
        exact ⟨j, (local_members r h hi j).mpr (Or.inr ⟨k, hk, hj⟩), rfl⟩
    · rintro ⟨j, hj, rfl⟩
      rcases (local_members r h hi j).mp hj with rfl | ⟨k, hk, hkj⟩
      · exact le_rfl
      · exact Relation.ReflTransGen.head (hs.mpr ⟨k, hk, rfl⟩)
          ((ih k (smaller hk) ((smaller hk).trans hi) _).mpr ⟨j, hkj, rfl⟩)

private theorem row_injective (r : ℕ → Row) (h : ∀ i < n, LocalFacts r i)
    {i j : ℕ} (hi : i < n) (hj : j < n) (eqv : (r i).node = (r j).node) : i = j := by
  have inc : ∀ a b : ℕ, a < b → b < n → score (r a).node < score (r b).node := by
    intro a b hab hbn
    induction b with
    | zero => omega
    | succ b ih =>
      obtain ⟨_, _, _, _, _, _, _, _, hh⟩ := h (b+1) hbn
      have hstep : score (r b).node < score (r (b+1)).node := by simpa using hh
      rcases Nat.lt_succ_iff_lt_or_eq.mp hab with hab | rfl
      · exact (ih hab (by omega)).trans hstep
      · exact hstep
  rcases lt_trichotomy i j with hij | hij | hji
  · exact False.elim ((inc i j hij hj).ne (congrArg score eqv))
  · exact hij
  · exact False.elim ((inc j i hji hi).ne (congrArg score eqv.symm))

theorem certificate_correct (r : ℕ → Row) (h : ∀ i < n, LocalFacts r i)
    {i : ℕ} (hi : i < n) :
    IncidenceAlgebra.mu ℤ (r i).node (r 0).node = (r i).value := by
  classical
  induction i using Nat.strong_induction_on with
  | ind i ih =>
    obtain ⟨_, _, _, _, hchain, hb, _, hv, _⟩ := h i hi
    let S := (members r i).toFinset
    have bound {j} (hj : j ∈ S) : j ≤ i :=
      of_decide_eq_true (List.all_eq_true.mp hb j (List.mem_toFinset.mp hj))
    have self : i ∈ S := List.mem_toFinset.mpr ((local_members r h hi i).mpr (Or.inl rfl))
    have maxNode (j : ℕ) (hj : j < n) : (r j).node ≤ (r 0).node := by
      obtain ⟨_, _, _, _, _, _, hz, _⟩ := h j hj
      exact (reach_iff_members r h hj _).mpr ⟨0, hz, rfl⟩
    have interval : Finset.Icc (r i).node (r 0).node = S.image (fun j => (r j).node) := by
      ext y
      rw [Finset.mem_Icc, Finset.mem_image]
      constructor
      · intro hy
        obtain ⟨j, hj, he⟩ := (reach_iff_members r h hi _).mp hy.1
        exact ⟨j, List.mem_toFinset.mpr hj, he⟩
      · rintro ⟨j, hj, rfl⟩
        exact ⟨(reach_iff_members r h hi _).mpr ⟨j, List.mem_toFinset.mp hj, rfl⟩,
          maxNode j (lt_of_le_of_lt (bound hj) hi)⟩
    have hinj : Set.InjOn (fun j => (r j).node) (S : Set ℕ) := by
      intro a ha b hb' he
      exact row_injective r h (lt_of_le_of_lt (bound ha) hi) (lt_of_le_of_lt (bound hb') hi) he
    have hzero : (r i).node = (r 0).node ↔ i = 0 :=
      ⟨row_injective r h hi (by omega), fun he => congrArg (fun j => (r j).node) he⟩
    have muSum := IncidenceAlgebra.sum_Icc_mu_left (𝕜 := ℤ) (r i).node (r 0).node
    rw [interval, Finset.sum_image hinj, if_congr hzero rfl rfl] at muSum
    have hnodup : (members r i).Nodup := (hchain.pairwise).nodup
    have valSum : ∑ j ∈ S, (r j).value = (if i = 0 then 1 else 0) := by
      simpa [S, List.sum_toFinset _ hnodup] using hv
    have other : ∑ j ∈ S.erase i, IncidenceAlgebra.mu ℤ (r j).node (r 0).node =
        ∑ j ∈ S.erase i, (r j).value := by
      apply Finset.sum_congr rfl
      intro j hj
      obtain ⟨hne, hj⟩ := Finset.mem_erase.mp hj
      exact ih j (lt_of_le_of_ne (bound hj) hne) (lt_of_le_of_lt (bound hj) hi)
    have h₁ := Finset.sum_erase_add S (fun j => IncidenceAlgebra.mu ℤ (r j).node (r 0).node) self
    have h₂ := Finset.sum_erase_add S (fun j => (r j).value) self
    omega

/-- Check a short consecutive block of rows. Splitting blocks limits kernel memory. -/
def Checks (r : ℕ → Row) (start : ℕ) : ℕ → Bool
  | 0 => true
  | k + 1 => Checks r start k && decide (LocalFacts r (start + k))

def Span (r : ℕ → Row) (a b : ℕ) := ∀ i, a ≤ i → i < b → LocalFacts r i

theorem fromChecks (r : ℕ → Row) (a k : ℕ) (h : Checks r a k = true) : Span r a (a+k) := by
  induction k with
  | zero => intro i lo hi; omega
  | succ k ih =>
    change Checks r a k && decide (LocalFacts r (a+k)) = true at h
    obtain ⟨h0, h1⟩ := Bool.and_eq_true_iff.mp h
    intro i lo hi
    by_cases e : i = a + k
    · subst i
      exact of_decide_eq_true h1
    · exact ih h0 i lo (by omega)

theorem joinRanges {r : ℕ → Row} {a b c : ℕ} (left : Span r a b) (right : Span r b c) :
    Span r a c := by
  intro i lo hi
  by_cases h : i < b
  · exact left i lo h
  · exact right i (by omega) hi

end MirzavaziriYaqubi.Factorizations


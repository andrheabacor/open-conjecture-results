namespace MirzavaziriYaqubi.Factorizations

/-- Repeated occurrences lead to one element for each unordered factorization. -/
theorem merges_two_two_three :
    (merges [2, 2, 3]).toFinset = {([2, 6] : List ℕ), [3, 4]} := by decide

theorem prime_sanity : factorMu 5 = 1 := by
  have he : bottomNode 5 = topNode 5 := by decide +kernel
  simp [factorMu, he]

private def eightTable : ℕ → Row
  | 0 => ⟨⟨[8]⟩, [], 1, 1, 1, 0⟩
  | 1 => ⟨⟨[2, 4]⟩, [0, 0], 3, -1, 2, 1⟩
  | 2 => ⟨⟨[2, 2, 2]⟩, [1, 1, 1, 1, 1, 1], 7, 0, 3, 2050⟩
  | _ => default

private theorem eightRows : ∀ i < 3, LocalFacts eightTable i := by
  have h := fromChecks eightTable 0 3 (by decide)
  exact fun i hi => h i (Nat.zero_le i) hi

theorem prime_cube_sanity : factorMu 8 = 0 := by
  have h₀ : topNode 8 = (eightTable 0).node := by decide
  have h₂ : bottomNode 8 = (eightTable 2).node := by decide +kernel
  rw [factorMu, h₀, h₂, certificate_correct eightTable eightRows (i := 2) (by decide)]
  rfl

theorem two_step_sanity : IncidenceAlgebra.mu ℤ (⟨[2, 4]⟩ : Node) ⟨[8]⟩ = -1 :=
  certificate_correct eightTable eightRows (i := 1) (by decide)

namespace Witness

theorem endpoint_value (h : ∀ i < 1752, LocalFacts table i) : factorMu 93312 = -57 := by
  have hbot : bottomNode 93312 = (table 1751).node := by decide +kernel
  have htop : topNode 93312 = (table 0).node := by decide
  rw [factorMu, hbot, htop, certificate_correct table h (i := 1751) (by decide)]
  rfl

theorem omega_witness : (93312 : ℕ).primeFactorsList.length = 13 := by decide +kernel

theorem arithmetic_witness : (93312 : ℕ) = 2^7 * 3^6 := by decide

end Witness
end MirzavaziriYaqubi.Factorizations


namespace MirzavaziriYaqubi.Factorizations

theorem witness_value : factorMu 93312 = -57 := Witness.endpoint_value Witness.allRows

theorem witness_fails_sign :
    ¬ (factorMu 93312 = 0 ∨
       Int.sign (factorMu 93312) = (-1 : ℤ) ^ ((93312 : ℕ).primeFactorsList.length + 1)) := by
  rw [witness_value, Witness.omega_witness]
  decide

/-- The refutation uses an integer greater than 1 and a genuine, nondegenerate factorization interval. -/
theorem refutation : ¬ Conjecture8 := fun h =>
  witness_fails_sign (h 93312 (by decide)).1

theorem refutation_even_if_one_is_excluded :
    ¬ (∀ n : ℕ, 2 ≤ n → factorMu n = 0 ∨
        Int.sign (factorMu n) = (-1 : ℤ) ^ (n.primeFactorsList.length + 1)) :=
  fun h => witness_fails_sign (h 93312 (by decide))

